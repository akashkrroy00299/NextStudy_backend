# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017/nexstudy

# Email (OTP / password reset)
EMAIL_USER=
EMAIL_PASS=

# JWT secrets (generate long random strings)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
RESET_PASSWORD_TOKEN_SECRET=

# Allowed frontend origins (comma-separated). Defaults to http://localhost:5173.
CLIENT_ORIGIN=http://localhost:5173

# Redis (REDIS_PASSWORD is optional — omit it for a local password-less Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=